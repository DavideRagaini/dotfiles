# ======================= Global Variables ======================= {{{
set {
    $M Mod4
    $A Mod1
    $C Control
    $S Shift

    $term footclient
    $drun bemenu-run
    # $drun tofi-run | xargs swaymsg exec --

    $gaps_inner 2
    $gaps_outer 2

    $laptop LVDS-1

    $maximize floating toggle, move position center, resize set width 100 ppt height 100 ppt

    $focus_prev_window swaymsg \[con_id=$(swaymsg -t get_tree | jq -r '.nodes | .[] | .nodes | . [] | select(.nodes != null) | .nodes | .[] | select(.name != null) | "\(.id?) \(.name?)"' | bemenu -i -l 5 | awk '{print $1}')] focus
}
# }}}
# ======================= Imports ======================= {{{
include {
    "module/bindings.conf"
    "machine/$(hostname).conf"
}
# }}}
# ======================= Workspaces ======================= {{{
for_window {
    [workspace=3] layout tabbed
    [workspace=4] layout tabbed
    # [workspace=5] layout tabbed
    [workspace=7] layout tabbed
    [workspace=8] layout tabbed
    [workspace=9] layout tabbed

    # [workspace=10] layout tabbed
    [workspace=11] layout tabbed
    [workspace=12] layout tabbed
    [workspace=13] layout tabbed
    [workspace=14] layout tabbed

    [workspace=15] layout tabbed
    [workspace=16] layout tabbed
    [workspace=17] layout tabbed
    [workspace=18] layout tabbed
    [workspace=19] layout tabbed
    [workspace=20] layout tabbed
}

exec_always {
    autotiling -l 2 -w \
        1 2 5 \ # Main
        11 12 13 14 \ #
        21 22 23 24 # eDP
}
# }}}
# ======================= Window Rules ======================= {{{
for_window {
    [app_id="dropdown|files|music|news|sysmon"] {
        floating enable
        resize set 95 ppt 95 ppt
        move position center
        move scratchpad
        scratchpad show
    }

    [title="flemacs|agenda"] {
        floating enable
        resize set 95 ppt 95 ppt
        move position center
        move scratchpad
        scratchpad show
    }

    [app_id="calc"] {
        floating enable
        resize set 65 ppt 65 ppt
        move position center
        move scratchpad
        scratchpad show
    }

    [app_id="mixer"] {
        floating enable
        resize set 65 ppt 35 ppt
        move position center
        move scratchpad
        scratchpad show
    }

    [app_id="libreoffice*"] floating disable
    [title="^Opening .*" app_id="org.mozilla.firefox"] floating enable, move workspace current, urgent enable, move position center
    [title="."] title_format "<b>%title</b> (%app_id)"
    [shell="xwayland"] title_format "[XWayland] %title"
#     [shell=".*"] title_format "%title :: %shell"
#     [app_id="mpv"] fullscreen enable
}

assign {
    [title=".*[Pp]rivate.*"]           workspace 17
    [title="Mozilla Firefox Private Browsing"] workspace 17
    [title=".*[Ww]isp[Gg]est.*|.*[Ww]yc [Mm]anager.*|.*INOLTRE_METRO_NETWORK.*|.*[Rr]adius [Mm]anager.*"] workspace 7
    [title="temacs"]                   workspace 20
    [title="Email"]                    workspace 18
    [title="ORG"]                      workspace 0

    [class="Ferdium"]                  workspace 19
    [class="sioyek"]                   workspace 16
    [class="term-emacsclient"]         workspace 1
    [class="xfreerdp"]                 workspace 6

    [app_id="com.github.wwmm.easyeffects"] workspace 7
    [app_id="baseterm"]                workspace 10
    [app_id="brave-mdhklhaglcijaohkkndgcmnphmnnfkdk-Default"] workspace 20
    [app_id="brave|librewolf"]         workspace 3
    [app_id="chromium"]                workspace 13
    [app_id="code"]                    workspace 17
    [app_id="emacs[client]?"]          workspace 2
    [app_id="ferdium"]                 workspace 19
    [app_id="firefox|qutebrowser"]     workspace 1
    [app_id="libreoffice*"]            workspace 4
    [app_id="mpv"]                     workspace 9
    [app_id="org.pwmt.zathura"]        workspace 16
    [app_id="org.remmina.Remmina"]     workspace 8
    [app_id="thunderbird"]             workspace 18
    [app_id="winboat"]                 workspace 8

}
# }}}
# ======================= Global Settings ======================= {{{
gaps {
    inner $gaps_inner
    outer $gaps_outer
}
smart_gaps on
default_border pixel 2
default_orientation auto
smart_borders on
title_align center
hide_edge_borders --i3 smart_no_gaps
mouse_warping output
focus_follows_mouse yes
popup_during_fullscreen smart
focus_wrapping yes
workspace_auto_back_and_forth yes
# }}}
# ======================= Colors ======================= {{{
set {
    $background '#282a36'
    $bgselected '#44475a'
    $foreground '#f8f8f2'
    $fgselected '#f8f8f2'
    $cyan       '#8be9fd'
    $green      '#50fa7b'
    $orange     '#ffb86c'
    $pink       '#ff79c6'
    $purple     '#bd93f9'
    $red        '#ff5555'
    $yellow     '#f1fa8c'
}
#      class                 border         background     text       indicator  child_border
client.focused               $bgselected    $background    $pink      $red       $pink
client.focused_inactive      $bgselected    $background    $orange    $cyan      $purple
client.focused_tab_title     $bgselected    $background    $orange    $cyan      $bgselected
client.unfocused             $bgselected    $background    $purple    $orange    $bgselected
client.urgent                $bgselected    $background    $red       $yellow    $bgselected
# }}}
# ======================= Inputs ======================= {{{
input type:keyboard {
    xkb_layout us
    xkb_variant altgr-intl
    # xkb_options "ctrl:swapcaps,altwin:swap_lalt_lwin"
    xkb_options "altwin:swap_lalt_lwin"
    xkb_numlock enabled
    repeat_delay 300
    repeat_rate 50
}

input type:pointer {
    left_handed disabled
    tap enabled
    natural_scroll disabled
    dwt enabled
    accel_profile "adaptive"
    pointer_accel 1
}

input type:touchpad {
    tap enable
    natural_scroll disable
    dwt enable
    accel_profile "adaptive"
    middle_emulation enabled
    # accel_profile "flat"
    # pointer_accel 0.5
}

seat {
    seat0 xcursor_theme Breeze_Purple 16
    seat0 hide_cursor 5000
    seat0 hide_cursor when-typing enable
}
# }}}
# ======================= Laptop ======================= {{{
bindswitch {
    --reload --locked lid:on exec swaylock -f -c 000000; output $laptop disable
    --reload --locked lid:off output $laptop enable
}
# }}}
# ======================= Autostart ======================= {{{
exec {
    mem-warn -t 6 -i 90 &
    wl-paste --watch cliphist store &
    foot --server &
    # track_prev_focus
    wlsunset -t 2400 -T 6500 -S 06:30 -s 20:00 -d 1800 &

    emacsclient -e '(doom/quickload-session t)' -c &
    firefox &
    footclient -a code -e tmux new-session -A -s code opencode &
    footclient -a code -e tmux new-session -A -s  zsh &

    # swayidle -w \
    #          timeout 290 'swaymsg "output * dpms off"' \
    #          resume 'swaymsg "output * dpms on"' \
    #          timeout 300 'swaylock -f -c 000000' \
    #          before-sleep 'swaylock'

        # timeout 180 'brightnessctl s 1%' resume 'brightnessctl s 35%' \
    swayidle -w \
        timeout 290 'sway-power-outputs off"' resume 'sway-power-outputs on"' \
        timeout 300 'swaylock -f -c 000000' before-sleep 'swaylock -f' \
        timeout 1800 'systemctl suspend-then-hibernate' before-sleep 'swaylock -f'
}
